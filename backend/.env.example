# Required. The backend refuses to start if any Langflow value is blank.
LANGFLOW_URL=http://127.0.0.1:7861
LANGFLOW_FLOW_ID=rambu
LANGFLOW_API_KEY=
OPENROUTER_API_KEY=
RAMBU_WHISPER_MODEL=small
RAMBU_DEMO_DELAY_SECONDS=5
RAMBU_DATABASE_PATH=data/rambu.sqlite3
# Required for background iPhone warnings. Delivery errors are logged explicitly.
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY_PATH=
APNS_BUNDLE_ID=id.rambu.puck
APNS_ENVIRONMENT=sandbox
