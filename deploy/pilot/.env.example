RAMBU_ENV_FILE=./.env.example
RAMBU_BIND_ADDRESS=127.0.0.1
RAMBU_BIND_PORT=8000
RAMBU_PUBLIC_URL=https://api.rambu.sfatimah.com
RAMBU_WHISPER_MODEL=small

LANGFLOW_URL=http://langflow:7860
LANGFLOW_FLOW_ID=rambu
LANGFLOW_API_KEY=replace-with-random-langflow-api-key
LANGFLOW_SUPERUSER=rambu
LANGFLOW_SUPERUSER_PASSWORD=replace-with-random-langflow-password
LANGFLOW_SECRET_KEY=replace-with-random-langflow-secret-key
OPENROUTER_API_KEY=replace-with-openrouter-api-key

APNS_TEAM_ID=replace-with-apple-team-id
APNS_KEY_ID=replace-with-apple-key-id
APNS_BUNDLE_ID=id.rambu.puck
APNS_ENVIRONMENT=production
